{
  "embedding": {
    "provider": "openai-compatible",
    "baseUrl": "https://openrouter.ai/api/v1",
    "model": "nvidia/llama-nemotron-embed-vl-1b-v2:free",
    "dimensions": 2048,
    "batchSize": 1,
    "apiKeyEnv": "OPENROUTER_API_KEY"
  },
  "indexing": {
    "include": [
      "app/**/*.ts",
      "app/**/*.tsx",
      "components/**/*.ts",
      "components/**/*.tsx",
      "lib/**/*.ts",
      "lib/**/*.tsx",
      "content/**/*.md",
      "docs/**/*.md",
      "README.md"
    ],
    "ignore": [
      "**/*.test.ts",
      "**/*.test.tsx",
      "node_modules/**",
      ".next/**"
    ]
  }
}
